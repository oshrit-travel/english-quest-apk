name: Build Android APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Install dependencies
        run: npm install --no-audit --no-fund

      - name: Logic tests (learning engine)
        run: npm test

      - name: Type check (informational)
        run: npm run typecheck
        continue-on-error: true

      - name: Build web app
        run: npm run build

      - name: Create Android project
        run: npx cap add android

      - name: Patch Android project (fullscreen, orientation, back button)
        run: node scripts/patch-android.mjs

      - name: Sync web build into Android
        run: npx cap sync android

      - name: Build debug APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: english-quest-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
